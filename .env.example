# ---- core
PORT=3000
APP_URL=https://crm.example.com          # public URL (used in emails, quote/booking links, OAuth redirects)
APP_SECRET=change-me-to-64-random-hex    # signs tokens/encrypts secrets; generated + stored in the DB if unset
DATA_DIR=./data                          # SQLite DB + uploaded files
COOKIE_SECURE=1                          # set when served over HTTPS (adds Secure cookies + HSTS)
TRUST_PROXY=1                            # set behind a reverse proxy/load balancer (uses X-Forwarded-For)
SUPERADMIN_EMAILS=you@example.com        # platform admin console (#/admin)
TRIAL_DAYS=14
RATE_LIMIT=600                           # requests/min per IP (API)
RATE_LIMIT_PUBLIC=30                     # requests/min per IP (signup, login, forms, booking)

# ---- email delivery (pick one; otherwise emails are logged, not sent)
MAIL_FROM="PipelineHQ <crm@example.com>"
RESEND_API_KEY=
POSTMARK_TOKEN=
INBOUND_DOMAIN=inbound.example.com       # domain of the BCC-to-log address shown to users

# ---- Google sign-in + Gmail send/sync  (OAuth redirect: $APP_URL/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe billing (per-seat subscription)  webhook: $APP_URL/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRICE_LABEL="$29 per user / month"

# ---- Twilio click-to-call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15550000000

# ---- AI assistant (Claude)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---- backups (npm run backup)
BACKUP_KEY=                               # passphrase → AES-256-GCM encrypted backups
BACKUP_KEEP=14
